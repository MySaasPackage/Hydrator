{
    "name": "mysaaspackage/hydrator",
    "type": "library",
    "description": "Hydrates DTOs from arrays",
    "keywords": ["hydration", "dto"],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MySaasPackage\\Hydrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "MySaasPackage\\Hydrator\\Tests\\": "tests/" }
    },
    "authors": [
        {
            "name": "Alef Castelo",
            "email": "alefaraujocastelo@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/MySaasPackage/Validation"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mysaaspackage/validation": "^0.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "friendsofphp/php-cs-fixer": "^3.19"
    },
    "minimum-stability": "dev"
}
